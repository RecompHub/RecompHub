{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RecompHub",
  "identifier": "com.recomphub.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RecompHub",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "publisher": "RecompHub",
    "shortDescription": "Launcher de jogos recomp com conquistas",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "template": "nsis/installer.nsi"
      }
    },
    "createUpdaterArtifacts": true,
    "copyright": "RecompHub",
    "longDescription": "Launcher para jogos recomp: baixa as releases oficiais do GitHub, gerencia versões e conta o tempo de jogo. Requer a sua própria ROM."
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDMTE0RjgxRDhEMjcyRjYKUldUMmN0TFlnVThSbk9aRzVLeXNna0tFWUpUS3VDY0loaEFTRkxZWHZoMFdDcDVSdHc1WVZMRFQK",
      "endpoints": [
        "https://github.com/RecompHub/RecompHub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
